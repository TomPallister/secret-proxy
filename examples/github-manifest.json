{
  "schemaVersion": 3,
  "account": {"vault": "Automation"},
  "githubLogins": {
    "copilot": {"domain": "github.com"},
    "cli": {"domain": "github.com", "scopes": ["repo", "read:org", "gist"]}
  },
  "secrets": {
    "GITHUB_COPILOT_SESSION_TOKEN": {
      "runtimeOnly": true,
      "placements": [{"kind": "header", "hosts": ["api.githubcopilot.com", "api.*.githubcopilot.com"], "name": "authorization", "template": "Bearer {secret}", "methods": ["GET", "POST"]}]
    },
    "GH_CLI_OAUTH_TOKEN": {
      "runtimeOnly": true,
      "placements": [
        {"kind": "header", "hosts": ["api.github.com"], "name": "authorization", "template": "token {secret}", "methods": ["GET", "HEAD"]},
        {"kind": "header", "hosts": ["api.github.com"], "name": "authorization", "template": "Bearer {secret}", "methods": ["GET", "HEAD"]}
      ]
    }
  }
}
