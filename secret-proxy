#!/Library/Developer/CommandLineTools/usr/bin/python3
"""Version-pinned daily CLI; engine selection remains /opt/secret-proxy/current."""
from pathlib import Path
import runpy
import sys

release = Path(__file__).resolve().parent
if release.parent != Path('/opt/secret-proxy/releases'):
    raise SystemExit('Use the installed root-owned launcher, not a source checkout.')
sys.path.insert(0, str(release))
runpy.run_path(str(release / 'manage.py'), run_name='__main__')
